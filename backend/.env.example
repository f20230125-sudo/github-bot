# Copy to backend/.env and fill in. Never commit .env.
# There is deliberately no Anthropic API key here: Patch calls the Claude Code CLI,
# which uses your signed-in Claude subscription.

# GitHub fine-grained token, limited to your own repos. Start read-only.
# You can also paste it on the site's Setup page, which checks it and saves it here.
DESK_GITHUB_TOKEN=
DESK_GITHUB_USER=f20230125-sudo

# Local site (the Next.js dev server) allowed to call this API.
DESK_FRONTEND_ORIGIN=http://localhost:3010

# Claude usage guard: stop calling Claude at or above these plan-usage percentages.
DESK_STOP_AT_SESSION_PCT=40
DESK_STOP_AT_WEEKLY_PCT=40
# Only used if Claude Code reports no usage percentage at all: this many calls per 5 hours. 0 = off.
DESK_CLAUDE_FIXED_ALLOWANCE=0

# Which models Patch asks for. "opus" works for writing but uses the limit faster.
DESK_CLAUDE_MODEL_WRITE=sonnet
DESK_CLAUDE_MODEL_SMALL=haiku

# Scheduled checks: one conditional request each. Seconds between checks with a token, and without.
DESK_WATCH=true
DESK_WATCH_INTERVAL=300
DESK_WATCH_INTERVAL_PUBLIC=1800

# Patch proposes; nothing is written to GitHub until you approve. Keep dry-run on at first.
DESK_DRY_RUN=true

# Whose name goes on a new LICENSE. Default: the name on your GitHub profile.
# DESK_LICENSE_HOLDER=
# Pull requests end with a line saying Patch drafted them and you approved them.
DESK_PR_FOOTER=true
